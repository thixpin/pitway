flowchart TD

    A["📋<br/>BRS/Backlog"]

    subgraph PLAN["🏁 Milestone"]
        direction LR
        C["📜<br/>Contract"]
        C --> R["⚖️<br/>Milestone Review"]
        R -. 🔄 .-> C
    end

    B["🔧<br/>small bounded fix"]
    subgraph QUICK["⚡ Quick Change (completed milestone)"]
        direction TD
        TTD["🛠<br/>TDD (RED→GREEN)"]
        TTD --> QC2["🔍<br/>Verify"]
        QC2 --> QC3["🏎️<br/>Commit"]
        QC2 -. 🔄 .-> TTD
    end
    B --> QUICK

    A --> PLAN
    PLAN --> D{{"🚦<br/>Human Approval"}}
    D --> E["📝<br/>Task Graph"]

    subgraph EXECUTE["Executing Tasks"]
        direction LR
        F["🛠<br/>TDD"]
        F --> G["⏱️<br/>Task Verification"]
        G --> H["🏎️<br/>Task Commit"]
    end

    E --> EXECUTE
    EXECUTE --> I["🧪<br/>Final Full Test"]
    I --> J["🏆<br/>Milestone Complete"]
    J --> K["🔀<br/>Milestone Merge"]

    I -.-> MR["⚖️<br/>Milestone revision"]
    MR -.-> EXECUTE
    
    G -. 🔄 .-> F

    EXECUTE .-> BL["📥<br/>Backlog"]

    style PLAN fill:none,stroke:#333,stroke-width:2px
    style QUICK fill:none,stroke:#333,stroke-width:2px
    style EXECUTE fill:none,stroke:#333,stroke-width:2px